{
  "name": "codex-ledger",
  "version": "0.2.0",
  "private": true,
  "description": "Audit-oriented SaaS accounting platform with ASC 606, receivables, SaaS metrics, and AI-assisted journal drafting",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": "22.23.2"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
