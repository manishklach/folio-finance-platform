{
  "name": "folio-finance-platform",
  "version": "0.3.0",
  "private": true,
  "description": "Enterprise cloud finance platform with GAAP accounting, controlled integrations, reconciliation, financial reporting, and SaaS metrics",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "migrate": "node scripts/migrate.js",
    "migrate:down": "node scripts/migrate.js --down",
    "migrate:rehearse": "node scripts/migration-rehearsal.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "verify-integrity": "node scripts/verify-integrity.js",
    "build": "vite build",
    "test:load": "node scripts/load-benchmark.js",
    "integrations:sync": "node --env-file-if-exists=.env scripts/sync-integration.js",
    "webhooks:worker": "node --env-file-if-exists=.env scripts/webhook-worker.js",
    "jobs:worker": "node --env-file-if-exists=.env scripts/background-worker.js",
    "accounting-validation": "node scripts/accounting-validation.js",
    "ops:preflight": "node scripts/ops-preflight.js",
    "privacy": "node scripts/privacy.js"
  },
  "engines": {
    "node": "22.23.2"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "argon2": "^0.45.1",
    "pdfkit": "^0.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
