# Optional: enables schema-constrained OpenAI journal proposals.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5.6

# HTTP server configuration.
PORT=4310

# SQLite database path. Parent directories are created automatically.
LEDGER_DB_PATH=./data/ledger.db
PLATFORM_DB_PATH=./data/platform.db
TENANT_DB_DIR=./data/tenants
BACKUP_DIR=./backups
JOB_ARTIFACT_DIR=./data/job-artifacts
JOB_ARTIFACT_RETENTION_DAYS=30
JOB_ARTIFACT_SWEEP_MINUTES=60
SESSION_COOKIE_SECURE=false
PUBLIC_ORIGIN=
HOST=127.0.0.1
SHUTDOWN_TIMEOUT_MS=20000
SENTRY_DSN=
SENTRY_DSN_FILE=
AI_MONTHLY_DRAFT_LIMIT=200

# Authenticated admission control. Expensive routes use the stricter heavy tenant pool.
ADMISSION_GLOBAL_CONCURRENCY=64
ADMISSION_TENANT_CONCURRENCY=8
ADMISSION_HEAVY_TENANT_CONCURRENCY=2
ADMISSION_USER_REQUESTS_PER_MINUTE=240
ADMISSION_HEAVY_TENANT_REQUESTS_PER_MINUTE=30
ADMISSION_MAX_TRACKED_PRINCIPALS=10000
BACKGROUND_WORKER_POLL_MS=1000
BACKGROUND_WORKER_LEASE_SECONDS=120
BACKUP_ENCRYPTION_KEY_FILE=
BACKUP_KEY_ID=
BOOTSTRAP_TOKEN=
BOOTSTRAP_TOKEN_FILE=

# Configure these through a secrets manager in production.
WEBHOOK_SECRET_STRIPE=
WEBHOOK_SECRET_STRIPE_FILE=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_SECRET_PAYROLL=
WEBHOOK_SECRET_PAYROLL_FILE=
WEBHOOK_SECRET_EXPENSES=
WEBHOOK_SECRET_EXPENSES_FILE=
