{$FOLIO_DOMAIN} {
  encode zstd gzip

  @internal path /metrics
  respond @internal 404

  reverse_proxy folio:4310 {
    health_uri /readyz
    health_interval 15s
    health_timeout 3s
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }

  log {
    output stdout
    format json
  }
}
